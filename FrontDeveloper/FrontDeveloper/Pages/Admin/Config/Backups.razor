@page "/Admin/Backups"

@using MudBlazor
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer>
    <MudGrid>
        <MudItem xs="12">
            <MudTypography Variant="Variants.H5">Gerenciamento de Backups e Recuperação</MudTypography>
            <MudTypography Variant="Variants.Body1">
                Realize backups manuais, agende backups automáticos e recupere dados facilmente.
            </MudTypography>
        </MudItem>

        <!-- Backup Manual -->
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudTypography Variant="Variants.H6" Class="mb-2">Realizar Backup Manual</MudTypography>
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        FullWidth="true"
                        StartIcon="@Icons.Material.Filled.Backup"
                        @onclick="IniciarBackupManual">
                        Iniciar Backup Manual
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Agendar Backup Automático -->
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudTypography Variant="Variants.H6" Class="mb-2">Agendar Backup Automático</MudTypography>
                    <MudTextField 
                        Label="Frequência" 
                        Variant="Variant.Filled"
                        @bind-Value="frequencia" 
                        StartIcon="@Icons.Material.Filled.Schedule"
                        FullWidth="true" />
                    
                    <MudTextField
                        T="string"
                        Label="Hora" 
                        Variant="Variant.Filled"
                        InputType="InputType.Time"
                        @bind-Value="horaBackup" 
                        StartIcon="@Icons.Material.Filled.AccessTime"
                        FullWidth="true" />

                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Secondary"
                        FullWidth="true"
                        StartIcon="@Icons.Material.Filled.Alarm"
                        @onclick="OnButtonClicked">
                        Agendar Backup
                    </MudButton>

                    <MudChip T="string">@state</MudChip>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Restaurar Backup -->
        <MudItem xs="12" md="6">
            <MudCard>
                <MudCardContent>
                    <MudTypography Variant="Variants.H6" Class="mb-2">Restaurar Backup</MudTypography>
                    <MudSelect Label="Selecione Backup" Variant="Variant.Filled" @bind-Value="backupSelecionado" StartIcon="@Icons.Material.Filled.Restore" FullWidth="true">
                        <MudSelectItem Value="1">Backup 1 - 01/01/2025</MudSelectItem>
                        <MudSelectItem Value="2">Backup 2 - 02/01/2025</MudSelectItem>
                    </MudSelect>
                    
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Error"
                        FullWidth="true"
                        StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                        @onclick="RestaurarBackup">
                        Restaurar Backup
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Histórico de Backups -->
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    <MudTypography Variant="Variants.H6" Class="mb-2">Histórico de Backups Realizados</MudTypography>
                    <MudTable Items="@historicoBackups" Hover="true">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Tipo de Backup</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Tamanho</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.Data</MudTd>
                            <MudTd DataLabel="Tipo de Backup">@context.TipoBackup</MudTd>
                            <MudTd DataLabel="Status">@context.Status</MudTd>
                            <MudTd DataLabel="Tamanho">@context.Tamanho</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string frequencia = "";
    private string horaBackup = "";
    private string backupSelecionado = "";
    private string state = "A caixa de diálogo ainda não foi aberta";

    private List<BackupHistorico> historicoBackups = new()
    {
        new BackupHistorico { Data = "01/01/2025", TipoBackup = "Completo", Status = "Sucesso", Tamanho = "5GB" },
        new BackupHistorico { Data = "02/01/2025", TipoBackup = "Incremental", Status = "Falha", Tamanho = "2GB" },
        new BackupHistorico { Data = "03/01/2025", TipoBackup = "Completo", Status = "Sucesso", Tamanho = "5GB" },
    };

    private void IniciarBackupManual()
    {
        Console.WriteLine("Backup manual iniciado...");
        Snackbar.Add("Backup manual iniciado com sucesso!", Severity.Info);
    }

    private async Task OnButtonClicked()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Aviso",
            "Tem certeza que deseja agendar o backup?",
            yesText: "Agendar",
            cancelText: "Cancelar"
        );

        if (result == true)
        {
            await AgendarBackup();
        }
        else
        {
            state = "Operação cancelada!";
        }

        StateHasChanged();
    }

    private async Task AgendarBackup()
    {
        if (string.IsNullOrWhiteSpace(frequencia) || string.IsNullOrWhiteSpace(horaBackup))
        {
            Snackbar.Add("Erro: Frequência e hora do backup são obrigatórias.", Severity.Error);
            return;
        }

        await Task.Delay(1000);
        Console.WriteLine($"Backup agendado para {frequencia} às {horaBackup}.");
        Snackbar.Add("O backup foi agendado com sucesso!", Severity.Success);
        state = "Backup agendado!";
    }

    private void RestaurarBackup()
    {
        if (!string.IsNullOrEmpty(backupSelecionado))
        {
            Console.WriteLine($"Restaurando backup {backupSelecionado}...");
            Snackbar.Add("Backup restaurado com sucesso!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Erro: Falha ao restaurar backup! Backup não selecionado.", Severity.Error);
        }
    }

    public class BackupHistorico
    {
        public string Data { get; set; } = "";
        public string TipoBackup { get; set; } = "";
        public string Status { get; set; } = "";
        public string Tamanho { get; set; } = "";
    }
}

