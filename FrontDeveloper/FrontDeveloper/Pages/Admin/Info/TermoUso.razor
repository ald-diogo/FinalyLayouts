@page "/Admin/TermoUso"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h4" Align="Align.Center" Class="my-4">
        Termos de Uso - Sistema de Gestão Acadêmica
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mb-4">
        Leia atentamente os termos antes de utilizar a plataforma.
    </MudAlert>

    <MudGrid>
        <MudItem xs="12" sm="12" md="6">
            <MudPaper Elevation="4" Class="p-4" Style="border-radius: 10px; background: linear-gradient(to right, #6A11CB, #2575FC); color: white;">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" /> Aceitação dos Termos
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Justify">
                    Ao utilizar nosso sistema, você concorda com todos os termos e condições descritos.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="12" md="6">
            <MudPaper Elevation="4" Class="p-4" Style="border-radius: 10px; background: #f5f5f5;">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" /> Privacidade e Segurança
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Justify">
                    Respeitamos sua privacidade e protegemos seus dados conforme nossa Política de Privacidade.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/Admin/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>
</MudContainer>

