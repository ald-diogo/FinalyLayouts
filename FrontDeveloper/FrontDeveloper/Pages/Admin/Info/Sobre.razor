@page "/Admin/Sobre"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
        Bem-vindo ao Painel Administrativo
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-2">
        Esta seção fornece um guia sobre a gestão de usuários, configurações do sistema, segurança e suporte.
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mt-5">
        Para dúvidas ou suporte técnico, entre em contato com a equipe de administração.
    </MudAlert>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.People" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Gestão de Usuários
                </MudText>
                <MudText Align="Align.Center">
                    Administração e controle de usuários do sistema.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Primary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Configurações do Sistema
                </MudText>
                <MudText Align="Align.Center">
                    Ajuste de parâmetros, backup e monitoramento do sistema.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Segurança
                </MudText>
                <MudText Align="Align.Center">
                    Controle de acessos, gestão de senhas e proteção de dados.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.Build" Color="Color.Error" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Manutenção
                </MudText>
                <MudText Align="Align.Center">
                    Gerenciamento de atualizações e suporte técnico.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" href="/Admin/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>

    <MudPaper Elevation="4" Class="mt-5">
        <MudCarousel TData="string" Class="my-4">
            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Assessment" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Relatórios
                </MudText>
                <MudText Align="Align.Center">
                    Geração de estatísticas e relatórios administrativos.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.NotificationImportant" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Monitoramento do Sistema
                </MudText>
                <MudText Align="Align.Center">
                    Visualização de eventos críticos e alertas administrativos.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Backup" Color="Color.Default" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Backups
                </MudText>
                <MudText Align="Align.Center">
                    Procedimentos para armazenamento e recuperação de dados.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Help" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Suporte
                </MudText>
                <MudText Align="Align.Center">
                    Contato para suporte técnico e dúvidas administrativas.
                </MudText>
            </MudCarouselItem>
        </MudCarousel>
    </MudPaper>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-4">
        Ao utilizar a plataforma, você concorda com nossos
        <MudLink Href="/Admin/TermoUso" Target="_blank" Color="Color.Primary">
            Termos de Uso
        </MudLink>
        e nossa
        <MudLink Href="/Admin/Politica" Target="_blank" Color="Color.Primary">
            Política de Privacidade
        </MudLink>.
    </MudText>
</MudContainer>





