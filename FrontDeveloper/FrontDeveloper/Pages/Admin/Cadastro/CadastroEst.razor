    {
        throw new NotImplementedException();
    }

    private Task<IEnumerable<string>>? SearchPeriodos(string? arg1, CancellationToken arg2)
    {
        throw new NotImplementedException();
    }

    private Task<IEnumerable<string>>? SearchCursos(string? arg1, CancellationToken arg2)
    {
        throw new NotImplementedException();
    }

    private Task<IEnumerable<string>>? SearchClasses(string? arg1, CancellationToken arg2)
    {
        throw new NotImplementedException();
    }

    private Task<IEnumerable<string>>? SearchTurmas(string? arg1, CancellationToken arg2)
    {
        throw new NotImplementedException();
    }

}








