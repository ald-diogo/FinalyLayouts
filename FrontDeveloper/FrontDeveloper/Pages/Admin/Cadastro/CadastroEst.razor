@page "/CadastroEst"
@using MudBlazor
@using System.Linq

@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h4" Align="Align.Center">Cadastro de Estudante</MudText>

    <MudForm @ref="form" OnValidSubmit="HandleValidSubmit">
        <MudGrid>
            <!-- Linha 1 -->
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="nome" Label="Nome" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="genero"
                    Label="Gênero"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite um gênero"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchGeneros" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField 
                    T="DateTime?"
                    ShrinkLabel
                    @bind-Value="_dataNascimento"
                    Format="yyyy-MM-dd" 
                    Label="Data de Nascimento"  
                    InputType="InputType.Date"
                    Variant="Variant.Outlined"/>
            </MudItem>

            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="periodo"
                    Label="Período"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite um período"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchPeriodos" />
            </MudItem>

            <!-- Linha 2 -->
            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="curso"
                    Label="Curso"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite um curso"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchCursos" />
            </MudItem>

            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="anoLectivo"
                    Label="Ano Lectivo"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite um ano lectivo"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchAnosLectivos" />
            </MudItem>

            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="classe"
                    Label="Classe"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite uma classe"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchClasses" />
            </MudItem>

            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="turma"
                    Label="Turma"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite uma turma"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchTurmas" />
            </MudItem>

            <!-- Linha 3 -->
            <MudItem xs="3">
                <MudAutocomplete 
                    @bind-Value="sala"
                    Label="Sala"
                    Variant="Variant.Outlined"
                    Placeholder="Escolha ou digite uma sala"
                    Dense="true"
                    CoerceValue="true"
                    Clearable="true"
                    SearchFunc="SearchSalas" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField 
                    ShrinkLabel 
                    @bind-Value="telefone"
                    Label="Telefone" 
                    Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField 
                    ShrinkLabel 
                    @bind-Value="morada" 
                    Label="Morada" 
                    Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField 
                    ShrinkLabel 
                    @bind-Value="email" 
                    Label="Email" 
                    Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <!-- Botão Cadastrar -->
        <MudButton
            Href="/Admin/ListaEstudantes"
            Type="Submit"
            Color="Color.Success"
            Variant="Variant.Filled"
            FullWidth="true"
            @onclick="@(() => Snackbar.Add("Cadastro Realizado Com Sucesso!", Severity.Success))">
            Cadastrar
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    private string nome, telefone, morada, email;
    private string genero = "", periodo = "", curso = "", anoLectivo = "", classe = "", turma = "", sala = "";
    private DateTime? _dataNascimento = null;
    private MudForm form;

    private List<string> listaGeneros = new() { "Masculino", "Feminino", "Outro" };
    private List<string> listaPeriodos = new() { "Manhã", "Tarde", "Pós-Laboral" };
    private List<string> listaCursos = new() { "Ciência da Computação", "Engenharia Elétrica", "Administração" };
    private List<string> listaAnosLectivos = new() { "2024/2025", "2025/2026", "2026/2027" };
    private List<string> listaClasses = new() { "10", "11", "12" };
    private List<string> listaTurmas = new() { "A", "B", "C" };
    private List<string> listaSalas = new() { "Sala 01", "Sala 02", "Sala 03" };

    
    
    private async Task<IEnumerable<string>> SearchPeriodos(string text) => await FiltrarLista(text, listaPeriodos);
    private async Task<IEnumerable<string>> SearchCursos(string text) => await FiltrarLista(text, listaCursos);
    private async Task<IEnumerable<string>> SearchAnosLectivos(string text) => await FiltrarLista(text, listaAnosLectivos);
    private async Task<IEnumerable<string>> SearchClasses(string text) => await FiltrarLista(text, listaClasses);
    private async Task<IEnumerable<string>> SearchTurmas(string text) => await FiltrarLista(text, listaTurmas);
    private async Task<IEnumerable<string>>? SearchSalas(string? text, CancellationToken cancellationToken) => await FiltrarLista(text, listaSalas);

    private async Task<IEnumerable<string>> FiltrarLista(string text, List<string> lista)
    {
        await Task.Delay(200); // Simula um pequeno delay para melhorar a experiência do usuário

        if (string.IsNullOrWhiteSpace(text))
            return lista; // Retorna a lista completa se nada for digitado

        var resultado = lista
            .Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase))
            .ToList();

        InvokeAsync(StateHasChanged); // Garante que a interface seja atualizada
        return resultado;
    }

    private async Task HandleValidSubmit()
    {
        // Redireciona para a página de listagem após o cadastro
        Navigation.NavigateTo("/Admin/ListaEstudantes");
    }

    private async Task<IEnumerable<string>>? SearchGeneros(string? text, CancellationToken cancellationToken)
    {
        await Task.Delay(200); // Simula um pequeno delay para melhor experiência
        var listaGeneros = new List<string> { "Masculino", "Feminino", "Outro" };

        if (string.IsNullOrWhiteSpace(text))
            return listaGeneros; // Retorna toda a lista se nada for digitado

        return listaGeneros.Where(g => g.Contains(text, StringComparison.OrdinalIgnoreCase)).ToList();
    }


