@page "/CadastroEst"
@using MudBlazor
@using System.Linq

@inject EstudanteService EstudanteService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h4" Align="Align.Center">Cadastro de Estudante</MudText>

    <MudForm @ref="form" OnValidSubmit="HandleValidSubmit">
        <MudGrid>
            <!-- Linha 1 -->
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="nome" Label="Nome" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="genero" Label="Gênero" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="3">
                <MudTextField T="DateTime?" ShrinkLabel @bind-Value="_dataNascimento" Format="yyyy-MM-dd"
                              Label="Data de Nascimento" InputType="InputType.Date" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="periodo" Label="Período" Variant="Variant.Outlined" />
            </MudItem>

            <!-- Linha 2 -->
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="anoLectivo" Label="Ano Lectivo" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="classe" Label="Classe" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="turma" Label="Turma" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="curso" Label="Curso" Variant="Variant.Outlined" />
            </MudItem>

            <!-- Linha 3 -->
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="sala" Label="Sala" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="telefone" Label="Telefone" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="morada" Label="Morada" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="3">
                <MudTextField ShrinkLabel @bind-Value="email" Label="Email" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <!-- Botão corrigido -->
        <MudButton Type="Submit" Color="Color.Success" Variant="Variant.Filled" FullWidth="true">
            Cadastrar
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    private string nome, genero, periodo, curso, classe, anoLectivo, turma, sala, telefone, morada, email;
    
    private DateTime? _dataNascimento = null;
    private MudForm? form;

    private async Task HandleValidSubmit()
    {
        try
        {
            var novoEstudante = new Estudante
            {
                Nome = nome,
                Genero = genero,
                DataNascimento = _dataNascimento?.ToString("yyyy-MM-dd") ?? "N/A",
                Periodo = periodo,
                Curso = curso,
                AnoLectivo = anoLectivo,
                Classe = classe,
                Turma = turma,
                Sala = sala,
                Telefone = telefone,
                Morada = morada,
                Email = email
            };

            Snackbar.Add("Cadastro realizado com sucesso!", Severity.Success);

            await Task.Delay(500); // Pequeno atraso para garantir que o usuário veja a mensagem
            Navigation.NavigateTo("/Admin/ListaEstudantes", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao cadastrar: {ex.Message}", Severity.Error);
        }
    }
    
    private Task<IEnumerable<string>> FiltrarLista(string text, List<string> lista)
    {
        return Task.FromResult(lista.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase)).AsEnumerable());
    }
}










