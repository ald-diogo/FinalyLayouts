@page "/Admin/ListaEstudantes"
@using MudBlazor

@inject NavigationManager Navigation

<PageTitle>Lista de Estudantes</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary">Lista de Estudantes</MudText>

<MudButton
    Href="/CadastroEst"
    Variant="Variant.Filled"
    StartIcon="@Icons.Material.Filled.PersonAdd"
    Color="Color.Success"
    Class="novo-estudante-btn">
    Novo Estudante
</MudButton>

<MudContainer Class="container-com-espaco">
    <MudTable Items="@estudantes" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Gênero</MudTh>
            <MudTh>Data de Nascimento</MudTh>
            <MudTh>Período</MudTh>
            <MudTh>Curso</MudTh>
            <MudTh>Ano Lectivo</MudTh>
            <MudTh>Classe</MudTh>
            <MudTh>Turma</MudTh>
            <MudTh>Sala</MudTh>
            <MudTh>Telefone</MudTh>
            <MudTh>Morada</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nome</MudTd>
            <MudTd>@context.Genero</MudTd>
            <MudTd>@context.DataNascimento</MudTd>
            <MudTd>@context.Periodo</MudTd>
            <MudTd>@context.Curso</MudTd>
            <MudTd>@context.AnoLectivo</MudTd>
            <MudTd>@context.Classe</MudTd>
            <MudTd>@context.Turma</MudTd>
            <MudTd>@context.Sala</MudTd>
            <MudTd>@context.Telefone</MudTd>
            <MudTd>@context.Morada</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>
                <MudIconButton 
                    Icon="@Icons.Material.Filled.Edit" 
                    Color="Color.Primary" OnClick="() => EditarEstudante(context)" />
                <MudIconButton
                    Icon="@Icons.Material.Filled.Delete"
                    Color="Color.Error" 
                    OnClick="() => ExcluirEstudante(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

<style>
    .novo-estudante-btn {
        margin-bottom: 20px;
        margin-left: 20px;
    }

    .container-com-espaco {
        margin-top: 20px;
    }
</style>

@code {
    [Inject] private EstudanteService EstudanteService { get; set; }

    private List<Estudante> estudantes = new();
    
    protected override void OnInitialized()
    {
        // Dados simulados. Aqui você pode buscar os dados de um banco de dados ou API
        estudantes = new List<Estudante>
        {
            new Estudante { Nome = "João Silva", DataNascimento="null", Genero = "Masculino", Periodo = "Manhã", Curso = "Ciência da Computação", AnoLectivo = "2025", Classe = "1ª", Turma = "A", Sala = "101", Telefone = "912345678", Morada = "Rua A", Email = "joao@example.com" },
            new Estudante { Nome = "Maria Costa", DataNascimento="null", Genero = "Feminino", Periodo = "Tarde", Curso = "Engenharia", AnoLectivo = "2025", Classe = "2ª", Turma = "B", Sala = "102", Telefone = "913456789", Morada = "Rua B", Email = "maria@example.com" }
        };
        EstudanteService.OnChange += AtualizarLista;
    }

    private void AtualizarLista()
    {
        InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EstudanteService.OnChange -= AtualizarLista;
    }

    private void EditarEstudante(Estudante estudante)
    {
        Navigation.NavigateTo("/CadastroEst");
    }

    private void ExcluirEstudante(Models.Estudante estudante)
    {
        EstudanteService.RemoverEstudante(estudante);
        AtualizarLista();
    }

    public class Estudante
    {
        public string Nome { get; set; }
        public string Genero { get; set; }
        public string DataNascimento { get; set; }
        public string Periodo { get; set; }
        public string Curso { get; set; }
        public string AnoLectivo { get; set; }
        public string Classe { get; set; }
        public string Turma { get; set; }
        public string Sala { get; set; }
        public string Telefone { get; set; }
        public string Morada { get; set; }
        public string Email { get; set; }
    }

    private void ExcluirEstudante(Estudante estudante)
    {
        throw new NotImplementedException();
    }

}
