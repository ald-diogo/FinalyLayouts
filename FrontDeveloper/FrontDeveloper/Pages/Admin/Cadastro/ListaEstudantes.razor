@page "/Admin/ListaEstudantes"
@using MudBlazor

@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Lista de Estudantes</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary">Lista de Estudantes</MudText>

<!-- Botão para cadastrar um novo estudante -->
<MudButton
    Href="/CadastroEst"
    Variant="Variant.Filled"
    StartIcon="@Icons.Material.Filled.PersonAdd"
    Color="Color.Success"
    Class="novo-estudante-btn">
    Novo Estudante
</MudButton>

<MudContainer Class="container-com-espaco">
    <!-- Tabela para exibir a lista de estudantes -->
    <MudTable Items="@estudantes" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Gênero</MudTh>
            <MudTh>Data de Nascimento</MudTh>
            <MudTh>Período</MudTh>
            <MudTh>Curso</MudTh>
            <MudTh>Ano Lectivo</MudTh>
            <MudTh>Classe</MudTh>
            <MudTh>Turma</MudTh>
            <MudTh>Sala</MudTh>
            <MudTh>Telefone</MudTh>
            <MudTh>Morada</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nome</MudTd>
            <MudTd>@context.Genero</MudTd>
            <MudTd>@context.DataNascimento</MudTd>
            <MudTd>@context.Periodo</MudTd>
            <MudTd>@context.Curso</MudTd>
            <MudTd>@context.AnoLectivo</MudTd>
            <MudTd>@context.Classe</MudTd>
            <MudTd>@context.Turma</MudTd>
            <MudTd>@context.Sala</MudTd>
            <MudTd>@context.Telefone</MudTd>
            <MudTd>@context.Morada</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="2" JustifyContent="Center">
                    <!-- Botão para editar estudante -->
                    <MudFab
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Edit"
                        OnClick="() => EditarEstudante(context)" />

                    <!-- Botão para excluir estudante -->
                    <MudFab
                        Color="Color.Error"
                        StartIcon="@Icons.Material.Filled.Delete"
                        OnClick="() => AbrirDialogoExclusao(context)" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

<style>
    .novo-estudante-btn {
        margin-bottom: 20px;
        margin-left: 20px;
    }

    .container-com-espaco {
        margin-top: 20px;
    }
</style>

@code {
    [Inject] private EstudanteService EstudanteService { get; set; }

    private List<Estudante> estudantes = new();
    private Estudante _estudanteSelecionado;

    protected override void OnInitialized()
    {
        // Simulando uma lista de estudantes cadastrados
        estudantes = new List<Estudante>
        {
            new Estudante { Nome = "João Silva", DataNascimento = "01/01/2000", Genero = "Masculino", Periodo = "Manhã", Curso = "Ciência da Computação", AnoLectivo = "2025", Classe = "1ª", Turma = "A", Sala = "101", Telefone = "912345678", Morada = "Rua A", Email = "joao@example.com" },
            new Estudante { Nome = "Maria Costa", DataNascimento = "15/03/2001", Genero = "Feminino", Periodo = "Tarde", Curso = "Engenharia", AnoLectivo = "2025", Classe = "2ª", Turma = "B", Sala = "102", Telefone = "913456789", Morada = "Rua B", Email = "maria@example.com" }
        };
    }

    // Método para redirecionar à tela de edição
    private void EditarEstudante(Estudante estudante)
    {
        Navigation.NavigateTo("/CadastroEst");
    }

    // Método para exibir a caixa de diálogo de exclusão
    private async Task AbrirDialogoExclusao(Estudante estudante)
    {
        _estudanteSelecionado = estudante;

        // Exibe a caixa de diálogo de confirmação
        bool? resultado = await DialogService.ShowMessageBox(
            "Confirmar Exclusão",
            $"Tem certeza que deseja excluir {estudante.Nome}?",
            "Sim", // Botão de confirmação
            "Não", // Botão de cancelamento
            options: new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }
        );

        // Se o usuário confirmar, remove o estudante
        if (resultado == true)
        {
            ExcluirEstudante();
        }
    }

    // Método para excluir o estudante
    private void ExcluirEstudante()
    {
        if (_estudanteSelecionado != null)
        {
            estudantes.Remove(_estudanteSelecionado);
            Snackbar.Add($"Estudante {_estudanteSelecionado.Nome} removido com sucesso!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Falha ao remover o estudante.", Severity.Error);
        }

        // Atualiza a interface
        StateHasChanged();
    }

    // Classe que representa os estudantes
    public class Estudante
    {
        public int EstudanteId { get; set; } = 0;
        public string Nome { get; set; }
        public string Genero { get; set; }
        public string DataNascimento { get; set; }
        public string Periodo { get; set; }
        public string Curso { get; set; }
        public string AnoLectivo { get; set; }
        public string Classe { get; set; }
        public string Turma { get; set; }
        public string Sala { get; set; }
        public string Telefone { get; set; }
        public string Morada { get; set; }
        public string Email { get; set; }
    }
}





