@page "/cadastro-coordenador"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject CoordenadorAcademicoService CoordenadorService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudPaper Class="p-4" Elevation="4">
    <MudForm>
        <!-- Cabeçalho da página -->
        <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">
            Cadastro de Coordenadores Acadêmicos
        </MudText>

        <!-- Primeira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Nome"
                    @bind-Value="coordenador.Nome"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.AccountCircle"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Gênero"
                    @bind-Value="coordenador.Genero"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Transgender"
                    AdornmentColor="Color.Primary"/>
            </MudItem>  

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    T="DateTime?"
                    Format="yyyy-MM-dd"
                    Label="Data de Contratação"
                    InputType="InputType.Date"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                    @bind-Value="coordenador.DataContratacao"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Segunda linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Departamento"
                    @bind-Value="coordenador.Departamento"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Apartment"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Curso Responsável"
                    @bind-Value="coordenador.CursoResponsavel"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.School"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Terceira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Usuário"
                    @bind-Value="coordenador.Usuario"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Person"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Senha"
                    @bind-Value="coordenador.Senha"
                    Type="password"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Lock"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Quarta linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Telefone"
                    @bind-Value="coordenador.Telefone"
                    Type="tel"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Smartphone"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Morada"
                    @bind-Value="coordenador.Morada"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.LocationOn"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="E-mail"
                    @bind-Value="coordenador.Email"
                    Type="email"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.ContactMail"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Botão de cadastro -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="4" Class="mt-4">
                <MudButton Color="Color.Success" Variant="Variant.Filled" Style="width: 100%; height: 100%;"
                           @onclick="@(() => { CadastrarCoordenador(); Snackbar.Add("Cadastro efetuado com sucesso!", Severity.Success); })">
                    Cadastrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    // Objeto que armazena os dados do coordenador
    private CoordenadorAcademico coordenador = new();

    // Método chamado na inicialização da página
    protected override async Task OnInitializedAsync()
    {
        var coordenadorJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "coordenadorEdicao");

        if (!string.IsNullOrEmpty(coordenadorJson))
        {
            coordenador = System.Text.Json.JsonSerializer.Deserialize<CoordenadorAcademico>(coordenadorJson);
        }
    }

    // Método para cadastrar ou editar um coordenador
    private async Task CadastrarCoordenador()
    {
        if (coordenador.CoordenadorId > 0)
            CoordenadorService.EditarCoordenador(coordenador);
        else
            CoordenadorService.AdicionarCoordenador(coordenador);

        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "coordenadorEdicao");
        Navigation.NavigateTo("/lista-coordenadores");
    }
}
