@page "/cadastro-funcionario"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject FuncionarioService FuncionarioService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudPaper Class="p-4" Elevation="4">
    <MudForm>
        <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">
            Cadastro de Funcionários
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Nome" @bind-Value="funcionario.Nome" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Gênero" @bind-Value="funcionario.Genero" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Cargo" @bind-Value="funcionario.Cargo" Variant="Variant.Outlined" Required />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Departamento" @bind-Value="funcionario.Departamento" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Data de Admissão" @bind-Value="funcionario.DataAdmissao" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Tipo de Contrato" @bind-Value="funcionario.TipoContrato" Variant="Variant.Outlined" Required />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Hora de Entrada" @bind-Value="funcionario.HoraEntrada" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Hora de Saída" @bind-Value="funcionario.HoraSaida" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Estado Civil" @bind-Value="funcionario.EstadoCivil" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Nacionalidade" @bind-Value="funcionario.Nacionalidade" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Documento de Identificação" @bind-Value="funcionario.DocumentoIdentificacao" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Salário" @bind-Value="funcionario.Salario" Variant="Variant.Outlined" Required />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Nome de Usuário" @bind-Value="funcionario.NomeUsuario" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Nível de Acesso" @bind-Value="funcionario.NivelAcesso" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Último Login" @bind-Value="funcionario.UltimoLogin" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Telefone" @bind-Value="funcionario.Telefone" Variant="Variant.Outlined" Required />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="Endereço" @bind-Value="funcionario.Endereco" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField Label="E-mail" @bind-Value="funcionario.Email" Variant="Variant.Outlined" Required />
            </MudItem>
        </MudGrid>

        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="4" Class="mt-4">
                <MudButton Color="Color.Success" Variant="Variant.Filled" Style="width: 100%; height: 100%;"
                           @onclick="@(() => { CadastrarFuncionario(); Snackbar.Add("Cadastro efetuado com sucesso!", Severity.Success); })">
                    Cadastrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    private Funcionario funcionario = new();

    protected override async Task OnInitializedAsync()
    {
        var funcionarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "funcionarioEdicao");

        if (!string.IsNullOrEmpty(funcionarioJson))
        {
            funcionario = System.Text.Json.JsonSerializer.Deserialize<Funcionario>(funcionarioJson);
        }
    }

    private async Task CadastrarFuncionario()
    {
        if (funcionario.FuncionarioId > 0)
            FuncionarioService.EditarFuncionario(funcionario);
        else
            FuncionarioService.AdicionarFuncionario(funcionario);

        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "funcionarioEdicao");
        Navigation.NavigateTo("/lista-funcionarios");
    }
}
