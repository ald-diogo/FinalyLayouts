@page "/lista-secretarios"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject SecretarioService SecretarioService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<!-- Título da página -->
<MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5" Class="mb-4 text-center">
    Lista de Secretários
</MudText>

<!-- Botão para adicionar um novo secretário -->
<MudGrid>
    <MudItem xs="2">
        <MudButton
            Href="/cadastro-secretario"
            Class="mt-4"
            Variant="Variant.Filled"
            Color="Color.Success">
            <MudIcon Icon="@Icons.Material.Filled.Work" Class="mr-1" />
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            Novo Secretário
        </MudButton>
    </MudItem>
    
    <MudItem xs="9">
        <MudTextField
            Variant="Variant.Outlined"
            Label="Pesquisar"
            @bind-Value="termoPesquisa"
            Adornment="Adornment.End"
            AdornmentIcon="@Icons.Material.Filled.Search"
            OnKeyUp="Pesquisar"
            Class="mt-4" />
    </MudItem>
</MudGrid>

<!-- Tabela para exibição da lista de secretários -->
<MudTable Items="secretarios" Hover="true" Class="mb-5">
    <!-- Cabeçalho da tabela -->
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Gênero</MudTh>
        <MudTh>Data de Admissão</MudTh>
        <MudTh>CPF/NIF</MudTh>
        <MudTh>RG</MudTh>
        <MudTh>Salário</MudTh>
        <MudTh>Horário de Trabalho</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Endereço</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    
    <!-- Preenchimento das linhas da tabela com os dados dos secretários -->
    <RowTemplate Context="secretario">
        <MudTd>@secretario.NomeCompleto</MudTd>
        <MudTd>@secretario.Genero</MudTd>
        <MudTd>@(secretario.DataAdmissao?.ToString("dd/MM/yyyy") ?? "Sem data")</MudTd>
        <MudTd>@secretario.CpfNif</MudTd>
        <MudTd>@secretario.Rg</MudTd>
        <MudTd>@secretario.Salario</MudTd>
        <MudTd>@secretario.HorarioTrabalho</MudTd>
        <MudTd>@secretario.Telefone</MudTd>
        <MudTd>@secretario.Endereco</MudTd>
        <MudTd>@secretario.Email</MudTd>
        <MudTd>
            <!-- Botão para editar secretário -->
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" @onclick="() => EditarSecretario(secretario)" />
            
            <!-- Botão para excluir secretário -->
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" @onclick="() => ConfirmarRemocao(secretario.Id)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private string termoPesquisa = "";
    private List<Secretario> secretarios = new();

    // Método chamado ao inicializar o componente para carregar os secretários
    protected override void OnInitialized()
    {
        secretarios = SecretarioService.GetSecretarios();
    }

    // Método para editar um secretário
    private async Task EditarSecretario(Secretario secretario)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "secretarioEdicao", System.Text.Json.JsonSerializer.Serialize(secretario));
        NavigationManager.NavigateTo("/cadastro-secretario");
    }

    // Método para confirmar a remoção de um secretário
    private async Task ConfirmarRemocao(int secretarioId)
    {
        bool? resultado = await DialogService.ShowMessageBox(
            "Aviso!",
            "Tem certeza que deseja excluir este secretário?",
            yesText: "Sim", cancelText: "Não");

        if (resultado == true)
        {
            RemoverSecretario(secretarioId);
            Snackbar.Add("Secretário removido com sucesso!", Severity.Success);
        }
    }

    // Método para remover um secretário
    private void RemoverSecretario(int id)
    {
        SecretarioService.RemoverSecretario(id);
        secretarios = SecretarioService.GetSecretarios();
        StateHasChanged();
    }
    
    // Método de pesquisa
    private void Pesquisar()
    {
        if (string.IsNullOrWhiteSpace(termoPesquisa))
        {
            secretarios = SecretarioService.GetSecretarios();
        }
        else
        {
            secretarios = SecretarioService.BuscarSecretarioPorNome(termoPesquisa);
        }
    }
}
