@page "/lista-estudantes"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject EstudanteService EstudanteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<!-- Título da página -->
<MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5" Class="mb-4 text-center">
    Lista de Estudantes
</MudText>

<!-- Botão para adicionar um novo estudante -->
<MudGrid>
    <MudItem xs="2">
        <MudButton
            Href="/cadastro-estudante"
            Class="mt-4"
            Variant="Variant.Filled"
            Color="Color.Success">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            Novo Estudante
        </MudButton>
    </MudItem>
    
    <MudItem xs="9">
        <MudTextField
            Variant="Variant.Outlined"
            Label="Pesquisar"
            @bind-Value="termoPesquisa"
            Adornment="Adornment.End"
            AdornmentIcon="@Icons.Material.Filled.Search"
            OnKeyUp="Pesquisar"
            Class="mt-4" />
    </MudItem>
</MudGrid>



<!-- Tabela para exibição da lista de estudantes -->
<MudTable Items="estudantes" Hover="true" Class="mb-5">
    <!-- Cabeçalho da tabela -->
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Gênero</MudTh>
        <MudTh>Data de Nascimento</MudTh>
        <MudTh>Curso</MudTh>
        <MudTh>Período</MudTh>
        <MudTh>Sala</MudTh>
        <MudTh>Turma</MudTh>
        <MudTh>Classe</MudTh>
        <MudTh>Ano de Frequência</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Morada</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    
    <!-- Preenchimento das linhas da tabela com os dados dos estudantes -->
    <RowTemplate Context="estudante">
        <MudTd>@estudante.Nome</MudTd>
        <MudTd>@estudante.Genero</MudTd>
        <MudTd>@(estudante.DataNascimento?.ToString("dd/MM/yyyy") ?? "Sem data")</MudTd>
        <MudTd>@estudante.Curso</MudTd>
        <MudTd>@estudante.Periodo</MudTd>
        <MudTd>@estudante.Sala</MudTd>
        <MudTd>@estudante.Turma</MudTd>
        <MudTd>@estudante.Classe</MudTd>
        <MudTd>@estudante.AnoFrequencia</MudTd>
        <MudTd>@estudante.Telefone</MudTd>
        <MudTd>@estudante.Morada</MudTd>
        <MudTd>@estudante.Email</MudTd>
        <MudTd>
            <!-- Botão para editar estudante -->
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" @onclick="() => EditarEstudante(estudante)" />
            
            <!-- Botão para excluir estudante -->
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" @onclick="() => ConfirmarRemocao(estudante.Id)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private string termoPesquisa = "";
    
    private List<Estudante> estudantes = new(); // Lista que armazena os estudantes

    // Método chamado ao inicializar o componente para carregar os estudantes
    protected override void OnInitialized()
    {
        estudantes = EstudanteService.GetEstudantes();
    }

    // Método para editar um estudante
    private async Task EditarEstudante(Estudante estudante)
    {
        // Armazena os dados do estudante na localStorage para edição
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "estudanteEdicao", System.Text.Json.JsonSerializer.Serialize(estudante));
        // Redireciona para a página de cadastro do estudante
        NavigationManager.NavigateTo("/cadastro-estudante");
    }

    // Método para confirmar a remoção de um estudante
    private async Task ConfirmarRemocao(int estudanteId)
    {
        // Exibe uma caixa de diálogo para confirmação
        bool? resultado = await DialogService.ShowMessageBox(
            "Aviso!",
            "Tem certeza que deseja excluir este estudante?",
            yesText: "Sim", cancelText: "Não");

        // Se o usuário confirmar, remove o estudante
        if (resultado == true)
        {
            RemoverEstudante(estudanteId);
            Snackbar.Add("Estudante removido com sucesso!", Severity.Success);
        }
    }

    // Método para remover um estudante
    private void RemoverEstudante(int id)
    {
        EstudanteService.RemoverEstudante(id); // Chama o serviço para remover
        estudantes = EstudanteService.GetEstudantes(); // Atualiza a lista de estudantes
        StateHasChanged(); // Atualiza a interface
    }
    
    // Método de pesquisa (a ser implementado)
    private void Pesquisar()
    {
        if (string.IsNullOrWhiteSpace(termoPesquisa))
        {
            estudantes = EstudanteService.GetEstudantes();
        }
        else
        {
            estudantes = EstudanteService.BuscarEstudantePorNome(termoPesquisa);
        }
    }
}




