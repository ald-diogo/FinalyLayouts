@page "/lista-estudantes"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject EstudanteService EstudanteService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<!-- Título -->
<MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5" Class="mb-4 text-center">
    Lista de Estudantes
</MudText>

<MudButton
    Href="/cadastro-estudante"
    Class="mb-5"
    Variant="Variant.Filled"
    Color="Color.Success">
    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
    Novo Estudante
</MudButton>

<MudTable Items="estudantes" Hover="true" Class="mb-5">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Gênero</MudTh>
        <MudTh>Data de Nascimento</MudTh>
        <MudTh>Curso</MudTh>
        <MudTh>Período</MudTh>
        <MudTh>Sala</MudTh>
        <MudTh>Turma</MudTh>
        <MudTh>Classe</MudTh>
        <MudTh>Ano de Frequência</MudTh>
        <MudTh>Telefone</MudTh>
        <MudTh>Morada</MudTh>
        <MudTh>E-mail</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    <RowTemplate Context="estudante">
        <MudTd>@estudante.Nome</MudTd>
        <MudTd>@estudante.Genero</MudTd>
        <MudTd>@(estudante.DataNascimento?.ToString("dd/MM/yyyy") ?? "Sem data")</MudTd>

        <MudTd>@estudante.Curso</MudTd>
        <MudTd>@estudante.Periodo</MudTd>
        <MudTd>@estudante.Sala</MudTd>
        <MudTd>@estudante.Turma</MudTd>
        <MudTd>@estudante.Classe</MudTd>
        <MudTd>@estudante.AnoFrequencia</MudTd>
        <MudTd>@estudante.Telefone</MudTd>
        <MudTd>@estudante.Morada</MudTd>
        <MudTd>@estudante.Email</MudTd>
        <MudTd>
            <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Edit" OnClick="() => EditarEstudante(estudante)" />
            <MudIconButton Color="Color.Error" Icon="@Icons.Material.Filled.Delete" OnClick="() => ConfirmarRemocao(estudante.Id)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Estudante> estudantes = new();

    protected override void OnInitialized()
    {
        estudantes = EstudanteService.GetEstudantes();
    }

    private async Task EditarEstudante(Estudante estudante)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "estudanteEdicao", System.Text.Json.JsonSerializer.Serialize(estudante));
        NavigationManager.NavigateTo("/cadastro-estudante");
    }

    private async Task ConfirmarRemocao(int estudanteId)
    {
        bool? resultado = await DialogService.ShowMessageBox(
            "Aviso!",
            "Tem certeza que deseja excluir este estudante?",
            yesText: "Sim", cancelText: "Não");

        if (resultado == true)
        {
            RemoverEstudante(estudanteId);
            Snackbar.Add("Estudante removido com sucesso!", Severity.Success);
        }
    }

    private void RemoverEstudante(int id)
    {
        EstudanteService.RemoverEstudante(id);
        estudantes = EstudanteService.GetEstudantes(); // Atualizar lista
        StateHasChanged();
    }
}



