@page "/cadastro-secretario"
@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject SecretarioService SecretarioService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudPaper Class="p-4" Elevation="4">
    <MudForm>
        <!-- Cabeçalho da página -->
        <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">
            Cadastro de Secretário
        </MudText>

        <!-- Primeira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Nome Completo"
                    @bind-Value="secretario.NomeCompleto"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.AccountCircle"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Gênero"
                    @bind-Value="secretario.Genero"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Transgender"
                    AdornmentColor="Color.Primary"/>
            </MudItem>  

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    T="DateTime?"
                    Format="yyyy-MM-dd"
                    Label="Data de Admissão"
                    InputType="InputType.Date"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.CalendarToday"
                    @bind-Value="secretario.DataAdmissao"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Segunda linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="CPF/NIF"
                    @bind-Value="secretario.CpfNif"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Badge"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="RG"
                    @bind-Value="secretario.Rg"
                    Variant="Variant.Outlined"
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.AssignmentInd"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Salário"
                    @bind-Value="secretario.Salario"
                    Variant="Variant.Outlined"
                    Type="number"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.MonetizationOn"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Terceira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Horário de Trabalho"
                    @bind-Value="secretario.HorarioTrabalho"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.AccessTime"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Nome de Usuário"
                    @bind-Value="secretario.NomeUsuario"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Person"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Senha"
                    @bind-Value="secretario.SenhaHash"
                    Variant="Variant.Outlined"
                    Type="password"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Lock"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Quarta linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Telefone"
                    @bind-Value="secretario.Telefone"
                    Type="tel"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Smartphone"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Endereço"
                    @bind-Value="secretario.Endereco"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.LocationOn"
                    AdornmentColor="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="E-mail"
                    @bind-Value="secretario.Email"
                    Type="email"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.ContactMail"
                    AdornmentColor="Color.Primary"/>
            </MudItem>
        </MudGrid>

        <!-- Botão de cadastro -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="4" Class="mt-4">
                <MudButton Color="Color.Success" Variant="Variant.Filled" Style="width: 100%; height: 100%;"
                           @onclick="@(() => { CadastrarSecretario(); Snackbar.Add("Cadastro efetuado com sucesso!", Severity.Success); })">
                    Cadastrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    // Objeto que armazena os dados do secretário
    private Secretario secretario = new();

    // Método chamado na inicialização da página
    protected override async Task OnInitializedAsync()
    {
        var secretarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "secretarioEdicao");

        if (!string.IsNullOrEmpty(secretarioJson))
        {
            secretario = System.Text.Json.JsonSerializer.Deserialize<Secretario>(secretarioJson);
        }
    }

    // Método para cadastrar ou editar um secretário
    private async Task CadastrarSecretario()
    {
        if (secretario.Id > 0)
            SecretarioService.EditarSecretario(secretario);
        else
            SecretarioService.AdicionarSecretario(secretario);

        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "secretarioEdicao");
        Navigation.NavigateTo("/lista-secretarios");
    }
}
