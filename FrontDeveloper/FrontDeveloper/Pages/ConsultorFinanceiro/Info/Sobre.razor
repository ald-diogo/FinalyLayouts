@page "/Con/Sobre"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
        Bem-vindo ao Manual de Usuário - Gestão Financeira
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-2">
        Aqui você encontra informações detalhadas sobre os recursos e funcionalidades da plataforma financeira acadêmica.
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mt-5">
        Para dúvidas ou suporte financeiro, entre em contato com nossa equipe de atendimento.
    </MudAlert>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Warning" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Gestão Financeira
                </MudText>
                <MudText Align="Align.Center">
                    Administração e controle das finanças acadêmicas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.PieChart" Color="Color.Secondary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Controle Orçamentário
                </MudText>
                <MudText Align="Align.Center">
                    Planejamento e controle dos recursos financeiros.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.BarChart" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Relatórios Financeiros
                </MudText>
                <MudText Align="Align.Center">
                    Monitoramento e auditoria das finanças acadêmicas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Gestão de Bolsas
                </MudText>
                <MudText Align="Align.Center">
                    Administração de bolsas e concessão de descontos.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" href="/Con/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>

    <MudPaper Elevation="4" Class="mt-5">
        <MudCarousel TData="string" Class="my-4">
            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Handshake" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Parcerias e Captação de Recursos
                </MudText>
                <MudText Align="Align.Center">
                    Desenvolva parcerias estratégicas e aumente a captação de recursos.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Atendimento Financeiro
                </MudText>
                <MudText Align="Align.Center">
                    Suporte para pagamentos, faturas e questões financeiras.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.BarChart" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Relatórios e Auditoria
                </MudText>
                <MudText Align="Align.Center">
                    Gerencie e audite relatórios financeiros detalhados.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Segurança Financeira
                </MudText>
                <MudText Align="Align.Center">
                    Proteção de dados e segurança em transações financeiras.
                </MudText>
            </MudCarouselItem>
        </MudCarousel>
    </MudPaper>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-4">
        Ao utilizar a plataforma, você concorda com nossos
        <MudLink Href="/Con/TermoUso" Target="_blank" Color="Color.Primary">
            Termos de Uso
        </MudLink>
        e nossa
        <MudLink Href="/Con/Politica" Target="_blank" Color="Color.Primary">
            Política de Privacidade
        </MudLink>.
    </MudText>
</MudContainer>
