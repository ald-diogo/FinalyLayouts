@page "/Con/gestao-bolsas"

<MudContainer>
    <!-- Cabeçalho -->
    <MudToolbar Class="mud-theme-primary">
        <MudIcon Icon="@Icons.Material.Outlined.School" Size="Size.Large" />
        <MudText Typo="Typo.h5" Class="ml-2">Gestão de Bolsas e Descontos</MudText>
        
        <MudSpacer />
        
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ShowHelp">
            <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" />
        </MudButton>
    </MudToolbar>

    <!-- Filtros -->
    <MudExpansionPanels>
        <MudExpansionPanel Text="Filtros de Pesquisa">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField
                        T="string"
                        Label="Nome do Aluno"
                        Variant="Variant.Outlined"
                        Adornment="Adornment.End" 
                        AdornmentIcon="@Icons.Material.Outlined.Person" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField
                        T="string"
                        Variant="Variant.Outlined"
                        Label="Tipo de Bolsa"
                        Adornment="Adornment.End"
                        AdornmentIcon="@Icons.Material.Outlined.School" />
                </MudItem>
            </MudGrid>
            
            <MudButton Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Outlined.Search" /> Buscar
            </MudButton>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <!-- Tabela de Registros -->
    <MudTable Items="@bolsas" Dense="true">
        <HeaderContent>
            <MudTh>Aluno</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Percentual</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        
        <RowTemplate Context="bolsa">
            <MudTd>@bolsa.NomeAluno</MudTd>
            <MudTd>@bolsa.Tipo</MudTd>
            <MudTd>@bolsa.Percentual%</MudTd>
            <MudTd>
                <MudChip Color="@(bolsa.Status == "Aprovado" ? Color.Success : Color.Warning)" 
                         Icon="@(bolsa.Status == "Aprovado" ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.HourglassEmpty)">
                    @bolsa.Status
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Color="Color.Success" OnClick="() => Aprovar(bolsa)">
                    <MudIcon Icon="@Icons.Material.Outlined.Check" />
                </MudButton>
                
                <MudButton Color="Color.Error" OnClick="() => Rejeitar(bolsa)">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <!-- Formulário de Concessão -->
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h6">Conceder Bolsa</MudText>
            
            <MudTextField
                T="string"
                Label="Nome do Aluno"
                Variant="Variant.Outlined"
                Adornment="Adornment.End"
                AdornmentIcon="@Icons.Material.Outlined.Person"/>
            
            <MudTextField
                Label="Tipo de Bolsa"
                T="string"
                Variant="Variant.Outlined"
                Adornment="Adornment.End"
                AdornmentIcon="@Icons.Material.Outlined.Person" />
            
            <MudTextField
                T="string"
                Label="Percentual"
                Type="number"
                Variant="Variant.Outlined"
                Adornment="Adornment.End"
                AdornmentIcon="@Icons.Material.Outlined.Person"/>
            <MudButton Color="Color.Primary">Conceder</MudButton>
        </MudCardContent>
    </MudCard>

    <!-- Gráficos -->
    <MudChart Type="ChartType.Line" Labels="@chartLabels" Datasets="@chartData" />

</MudContainer>

@code {
    private List<Bolsa> bolsas = new()
    {
        new Bolsa { NomeAluno = "João Silva", Tipo = "Integral", Percentual = 100, Status = "Aprovado" },
        new Bolsa { NomeAluno = "Maria Oliveira", Tipo = "Parcial", Percentual = 50, Status = "Pendente" }
    };

    private string[] chartLabels = { "Jan", "Fev", "Mar", "Abr" };
    private ChartSeries[] chartData =
    {
        new ChartSeries { Name = "Bolsas", Data = new double[] { 10, 15, 20, 30 } }
    };

    void Aprovar(Bolsa bolsa) => bolsa.Status = "Aprovado";
    void Rejeitar(Bolsa bolsa) => bolsa.Status = "Rejeitado";
    void ShowHelp() => Console.WriteLine("Exibir guia interativo");
    
    public class Bolsa
    {
        public string NomeAluno { get; set; }
        public string Tipo { get; set; }
        public int Percentual { get; set; }
        public string Status { get; set; }
    }
}

