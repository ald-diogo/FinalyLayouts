@page "/Coor/GradeCurricular"

@using FrontDeveloper.Pages.Models
@using FrontDeveloper.Pages.Services
@inject DisciplinaService DisciplinaService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<!-- Título da página -->
<MudText Typo="Typo.h6" Color="Color.Primary" Class="ml-2">Gerenciamento de Grade Curricular</MudText>

<!-- Botão para adicionar uma nova disciplina -->
<MudGrid>
    <MudItem xs="2">
        <MudButton
            Href="/cadastro-disciplina"
            Class="mt-4"
            Variant="Variant.Filled"
            Color="Color.Success">
            <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Class="mr-1" />
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
            Adicionar Disciplina
        </MudButton>
    </MudItem>
    
    <MudItem xs="9">
        <MudTextField
            Variant="Variant.Outlined"
            Label="Pesquisar"
            @bind-Value="termoPesquisa"
            Adornment="Adornment.End"
            AdornmentIcon="@Icons.Material.Filled.Search"
            OnKeyUp="Pesquisar"
            Class="mt-4" />
    </MudItem>
</MudGrid>

<!-- Tabela para exibição da lista de disciplinas -->
<MudTable Items="disciplinas" Hover="true" Class="mb-5">
    <!-- Cabeçalho da tabela -->
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Carga Horária</MudTh>
        <MudTh>Semestre</MudTh>
        <MudTh>Descrição</MudTh>
        <MudTh>Ações</MudTh>
    </HeaderContent>
    
    <!-- Preenchimento das linhas da tabela com os dados das disciplinas -->
    <RowTemplate Context="disciplina">
        <MudTd>@disciplina.Nome</MudTd>
        <MudTd>@disciplina.CargaHoraria horas</MudTd>
        <MudTd>@disciplina.Semestre</MudTd>
        <MudTd>@(string.IsNullOrEmpty(disciplina.Descricao) ? "Sem descrição" : disciplina.Descricao)</MudTd>
        <MudTd>
            <!-- Botão para editar disciplina -->
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" @onclick="() => EditarDisciplina(disciplina)" />
            
            <!-- Botão para excluir disciplina -->
            <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" @onclick="() => ConfirmarRemocao(disciplina.DisciplinaId)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private string termoPesquisa = "";
    
    private List<Disciplina> disciplinas = new(); // Lista que armazena as disciplinas

    // Método chamado ao inicializar o componente para carregar as disciplinas
    protected override void OnInitialized()
    {
        disciplinas = DisciplinaService.GetDisciplinas();
    }

    // Método para editar uma disciplina
    private async Task EditarDisciplina(Disciplina disciplina)
    {
        // Armazena os dados da disciplina na localStorage para edição
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "disciplinaEdicao", System.Text.Json.JsonSerializer.Serialize(disciplina));
        // Redireciona para a página de cadastro da disciplina
        NavigationManager.NavigateTo("/cadastro-disciplina");
    }

    // Método para confirmar a remoção de uma disciplina
    private async Task ConfirmarRemocao(int disciplinaId)
    {
        // Exibe uma caixa de diálogo para confirmação
        bool? resultado = await DialogService.ShowMessageBox(
            "Aviso!",
            "Tem certeza que deseja excluir esta disciplina?",
            yesText: "Sim", cancelText: "Não");

        // Se o usuário confirmar, remove a disciplina
        if (resultado == true)
        {
            RemoverDisciplina(disciplinaId);
            Snackbar.Add("Disciplina removida com sucesso!", Severity.Success);
        }
    }

    // Método para remover uma disciplina
    private void RemoverDisciplina(int id)
    {
        DisciplinaService.RemoverDisciplina(id); // Chama o serviço para remover
        disciplinas = DisciplinaService.GetDisciplinas(); // Atualiza a lista de disciplinas
        StateHasChanged(); // Atualiza a interface
    }
    
    // Método de pesquisa (a ser implementado)
    private void Pesquisar()
    {
        if (string.IsNullOrWhiteSpace(termoPesquisa))
        {
            disciplinas = DisciplinaService.GetDisciplinas();
        }
        else
        {
            disciplinas = DisciplinaService.BuscarDisciplinaPorNome(termoPesquisa);
        }
    }
}

