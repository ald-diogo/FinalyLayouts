@page "/Coor/Sobre"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
        Bem-vindo ao Manual de Usuário - Coordenação
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-2">
        Aqui você encontra informações detalhadas sobre os recursos e funcionalidades disponíveis na plataforma de coordenação.
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mt-5">
        Para dúvidas ou suporte, entre em contato com nossa equipe.
    </MudAlert>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Secondary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Administração
                </MudText>
                <MudText Align="Align.Center">
                    Gerencie permissões e configurações administrativas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Atribuição de Professores
                </MudText>
                <MudText Align="Align.Center">
                    Alocação de professores para disciplinas de forma eficiente.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Color="Color.Surface" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Grade Curricular
                </MudText>
                <MudText Align="Align.Center">
                    Estruture e organize a matriz curricular da instituição.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Desempenho Acadêmico
                </MudText>
                <MudText Align="Align.Center">
                    Monitore o desempenho dos alunos e avalie o progresso acadêmico.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" href="/Coor/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>

    <MudPaper Elevation="4" Class="mt-5">
        <MudCarousel TData="string" Class="my-4">
            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Schedule" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Gestão de Cronogramas
                </MudText>
                <MudText Align="Align.Center">
                    Organize e administre os cronogramas de aulas e eventos.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Timeline" Color="Color.Dark" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Monitoramento do Desempenho Acadêmico
                </MudText>
                <MudText Align="Align.Center">
                    Avalie o desempenho dos alunos e acompanhe sua evolução.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Atribuição de Professores
                </MudText>
                <MudText Align="Align.Center">
                    Distribua professores para disciplinas de maneira estratégica.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Administração do Sistema
                </MudText>
                <MudText Align="Align.Center">
                    Configure acessos e permissões dentro da plataforma.
                </MudText>
            </MudCarouselItem>
        </MudCarousel>
    </MudPaper>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-4">
        Ao utilizar a plataforma, você concorda com nossos
        <MudLink Href="/Coor/TermoUso" Target="_blank" Color="Color.Primary">
            Termos de Uso
        </MudLink>
        e nossa
        <MudLink Href="/Coor/Politica" Target="_blank" Color="Color.Primary">
            Política de Privacidade
        </MudLink>.
    </MudText>
</MudContainer>


