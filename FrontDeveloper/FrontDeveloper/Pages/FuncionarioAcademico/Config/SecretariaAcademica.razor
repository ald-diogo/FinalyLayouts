@page "/Fun/secretaria-academica"

<MudContainer>
    <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">Secretaria Acadêmica</MudText>
    <MudSpacer />

    <MudPaper Class="d-flex flex-row flex-nowrap p-2" Style="overflow-x: auto; width: 100%;">
        <MudNavLink
            Href="/Admin/GestaoUsuarios"
            Icon="@Icons.Material.Filled.PersonAdd"
            Text="Cadastro"
            Color="Color.Primary" />

        <MudNavLink
            Href="/Sec/gestao-documentacao"
            Icon="@Icons.Material.Filled.Description"
            Text="Documentos"
            Color="Color.Secondary" />

        <MudNavLink
            Href="/matrizes"
            Icon="@Icons.Material.Filled.School"
            Text="Matrizes"
            Color="Color.Info" />

        <MudNavLink
            Href="/Sec/matriculas"
            Icon="@Icons.Material.Filled.Assignment"
            Text="Matrículas"
            Color="Color.Warning" />

        <MudNavLink
            Href="/formatura"
            Icon="@Icons.Material.Filled.EmojiEvents"
            Text="Formatura"
            Color="Color.Success" />
    </MudPaper>


    <MudGrid Container>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="4" Class="p-4">
                <MudText Typo="Typo.h6">Gerenciamento Acadêmico</MudText>
                <MudButton
                    Href="/Admin/GestaoUsuarios"
                    Variant="Variant.Outlined"
                    Color="Color.Primary"
                    EndIcon="@Icons.Material.Filled.PersonAdd">
                    Cadastrar Aluno
                </MudButton>
                
                <MudButton
                    Href="/Sec/gestao-documentacao"
                    Variant="Variant.Outlined"
                    Color="Color.Secondary"
                    EndIcon="@Icons.Material.Filled.Description">
                    Emitir Documento
                </MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="4" Class="p-4">
                <MudText Typo="Typo.h6">Gestão de Matrículas</MudText>
                <MudButton
                    Href="/Sec/matriculas"
                    Variant="Variant.Outlined"
                    Color="Color.Success"
                    EndIcon="@Icons.Material.Filled.Assignment">
                    Nova Matrícula
                </MudButton>
                
                
                <MudButton
                    Href="/transferencias"
                    Variant="Variant.Outlined"
                    Color="Color.Error"
                    EndIcon="@Icons.Material.Filled.TransferWithinAStation">
                    Transferência
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private void ToggleTheme()
    {
        // Código para alternar entre temas claro e escuro
    }
}
