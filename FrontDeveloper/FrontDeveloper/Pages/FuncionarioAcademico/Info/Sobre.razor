@page "/Fun/Sobre"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
        Bem-vindo ao Manual de Usuário - Setor Funcional
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-2">
        Esta página fornece informações essenciais sobre os serviços de suporte técnico, financeiro, acadêmico e comunicação.
    </MudText>

    <MudAlert Severity="Severity.Info" Class="mt-5">
        Para dúvidas ou suporte, entre em contato com a equipe técnica ou a secretaria acadêmica.
    </MudAlert>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Warning" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Suporte Técnico e TI
                </MudText>
                <MudText Align="Align.Center">
                    Atendimento para questões de TI e manutenção de sistemas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Gestão Financeira
                </MudText>
                <MudText Align="Align.Center">
                    Administração financeira e controle de despesas acadêmicas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Coordenação e Professores
                </MudText>
                <MudText Align="Align.Center">
                    Apoio na gestão de professores e atribuição de aulas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.Chat" Color="Color.Info" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Atendimento e Comunicação
                </MudText>
                <MudText Align="Align.Center">
                    Central de atendimento para alunos e responsáveis.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" href="/Fun/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>

    <MudPaper Elevation="4" Class="mt-5">
        <MudCarousel TData="string" Class="my-4">
            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.MenuBook" Color="Color.Secondary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Secretaria Acadêmica
                </MudText>
                <MudText Align="Align.Center">
                    Gestão documental e acadêmica dos alunos e professores.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Suporte Técnico
                </MudText>
                <MudText Align="Align.Center">
                    Resolução de problemas técnicos e operacionais.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Default" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Segurança
                </MudText>
                <MudText Align="Align.Center">
                    Proteção de dados e segurança das operações do sistema.
                </MudText>
            </MudCarouselItem>
        </MudCarousel>
    </MudPaper>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-4">
        Ao utilizar a plataforma, você concorda com nossos
        <MudLink Href="/Fun/TermoUso" Target="_blank" Color="Color.Primary">
            Termos de Uso
        </MudLink>
        e nossa
        <MudLink Href="/Fun/Politica" Target="_blank" Color="Color.Primary">
            Política de Privacidade
        </MudLink>.
    </MudText>
</MudContainer>
