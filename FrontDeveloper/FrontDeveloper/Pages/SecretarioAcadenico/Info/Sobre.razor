@page "/Sec/Sobre"

@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Large" Class="text-center">
    <MudText Typo="Typo.h3" Align="Align.Center" Class="my-4">
        Bem-vindo ao Guia Interativo
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-2">
        Descubra as principais funcionalidades e benefícios do nosso sistema de gestão acadêmica.
    </MudText>
    
    <MudAlert Severity="Severity.Info" Class="mt-5">
        Caso tenha dúvidas, nossa equipe de suporte está pronta para ajudar!
    </MudAlert>

    <MudGrid Class="mt-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Color="Color.Error" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Painel de Gestão
                </MudText>
                <MudText Align="Align.Center">
                    Interface intuitiva para gerenciar todas as operações acadêmicas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.HowToReg" Color="Color.Secondary" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Matrículas e Rematrículas
                </MudText>
                <MudText Align="Align.Center">
                    Processo simplificado para inscrições e renovações acadêmicas.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Relatórios Financeiros
                </MudText>
                <MudText Align="Align.Center">
                    Análise detalhada de despesas e receitas institucionais.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="p-4">
                <MudIconButton Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Size="Size.Large" />
                <MudText Align="Align.Center" Class="mt-2">
                    Segurança e Acesso
                </MudText>
                <MudText Align="Align.Center">
                    Controle de permissões para garantir a segurança dos dados.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/Sec/Index" Class="mt-4">
        Voltar ao Início
    </MudButton>

    <MudPaper Elevation="4" Class="mt-5">
        <MudCarousel TData="string" Class="my-4">
            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Schedule" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Gestão de Horários
                </MudText>
                <MudText Align="Align.Center">
                    Planejamento otimizado para aulas e eventos acadêmicos.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Timeline" Color="Color.Dark" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Desempenho Acadêmico
                </MudText>
                <MudText Align="Align.Center">
                    Monitoramento contínuo do progresso estudantil.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Gestão de Professores
                </MudText>
                <MudText Align="Align.Center">
                    Atribuição eficiente de disciplinas e turmas.
                </MudText>
            </MudCarouselItem>

            <MudCarouselItem>
                <MudIconButton Icon="@Icons.Material.Filled.CalendarViewDay" Color="Color.Info" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
                    Administração de Eventos
                </MudText>
                <MudText Align="Align.Center">
                    Organização simplificada de atividades acadêmicas.
                </MudText>
            </MudCarouselItem>
        </MudCarousel>
    </MudPaper>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="my-4">
        Ao utilizar nossos serviços, você aceita nossos
        <MudLink Href="/Sec/TermoUso" Target="_blank" Color="Color.Primary">
            Termos de Uso
        </MudLink>
        e nossa
        <MudLink Href="/Sec/Politica" Target="_blank" Color="Color.Primary">
            Política de Privacidade
        </MudLink>.
    </MudText>
</MudContainer>


