@page "/Prof/Menu"

<MudNavLink Href="/Prof/Index" Match="NavLinkMatch.All">
    <MudIcon Icon="@Icons.Material.Filled.Home" IconColor="Color.Warning" />
    Início
</MudNavLink>

<MudNavGroup
    Icon="@Icons.Material.Filled.Dashboard"
    IconColor="Color.Error"
    Title="Painel"
    Expanded="true">
    <MudNavLink
        Href="/Prof/Feedback"
        Match="NavLinkMatch.Prefix"
        Icon="@Icons.Material.Filled.Feedback"
        IconColor="Color.Warning">
        Feedback
    </MudNavLink>

    <MudNavLink
        Href="/Prof/VerTurmas"
        Match="NavLinkMatch.Prefix"
        Icon="@Icons.Material.Filled.Class"
        IconColor="Color.Primary">
        Ver Turmas
    </MudNavLink>
    
    <!-- Ícone de gráfico, representando desempenho -->
    <MudNavLink
        Href="/Prof/LancarNotas"
        Match="NavLinkMatch.Prefix"
        Icon="@Icons.Material.Filled.Grade" 
        IconColor="Color.Warning">
        Lançar Notas
    </MudNavLink>


    <MudNavLink
        Href="/Prof/Avaliacao"
        Match="NavLinkMatch.Prefix"
        Icon="@Icons.Material.Filled.Grade"
        IconColor="Color.Info">
        Gestão de Avaliações
    </MudNavLink>

    <MudNavLink
        T="bool"
        Href="/Prof/Administracao"
        Match="NavLinkMatch.Prefix"
        Icon="@Icons.Material.Filled.Assessment"
        IconColor="Color.Primary">
        Administração e Relatório
    </MudNavLink>
</MudNavGroup>

<MudNavLink
    T="bool"
    Href="/Prof/Seguranca"
    Match="NavLinkMatch.Prefix"
    Icon="@Icons.Material.Filled.Lock"
    IconColor = "Color.Default">Segurança
</MudNavLink>

<MudNavLink
    Href="/Prof/Suporte"
    Match="NavLinkMatch.Prefix"
    Icon="@Icons.Material.Filled.Help"
    IconColor="Color.Surface">
    Suporte
</MudNavLink>

<MudNavLink
    Href="/Prof/Sobre"
    Match="NavLinkMatch.Prefix"
    Icon="@Icons.Material.Filled.Info"
    IconColor="Color.Info">
    Sobre
</MudNavLink>