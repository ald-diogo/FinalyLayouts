@page "/cadastro-professor"
@using BlazorCrud.Pages.Models
@using BlazorCrud.Pages.Services
@inject ProfessorService ProfessorService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudPaper Class="p-4" Elevation="4">
    <MudForm>
        <!-- Cabeçalho da página -->
        <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">
            Cadastro de Professores
        </MudText>

        <!-- Primeira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Nome Completo" 
                    @bind-Value="professor.NomeCompleto" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Gênero"
                    @bind-Value="professor.Genero"
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    T="DateTime?" 
                    Format="yyyy-MM-dd" 
                    Label="Data de Admissão" 
                    InputType="InputType.Date" 
                    Variant="Variant.Outlined" 
                    Required 
                    @bind-Value="professor.DataAdmissao" />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Número de Identificação"
                    @bind-Value="professor.NumeroIdentificacao"
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>
        </MudGrid>

        <!-- Segunda linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Departamento" 
                    @bind-Value="professor.Departamento" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Disciplinas Lecionadas" 
                    @bind-Value="professor.DisciplinasLecionadas" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Nacionalidade"
                    @bind-Value="professor.Nacionalidade" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Estado Civil"
                    @bind-Value="professor.EstadoCivil" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>
        </MudGrid>

        <!-- Terceira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Grau Acadêmico" 
                    @bind-Value="professor.GrauAcademico" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Número de Funcionário" 
                    @bind-Value="professor.NumeroFuncionario" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Regime de Trabalho" 
                    @bind-Value="professor.RegimeTrabalho" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Anos de Experiência"
                    @bind-Value="professor.ExperienciaAnos" 
                    Variant="Variant.Outlined" 
                    Type="number"
                    Required />
            </MudItem>
        </MudGrid>

        <!-- Quarta linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="2" Class="mb-3">
                <MudTextField 
                    Label="Nome de Usuário" 
                    @bind-Value="professor.NomeUsuario" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="2" Class="mb-3">
                <MudTextField 
                    Label="Senha" 
                    @bind-Value="professor.Senha" 
                    Variant="Variant.Outlined" 
                    InputType="InputType.Password" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="2" Class="mb-3">
                <MudTextField 
                    Label="Telefone" 
                    @bind-Value="professor.Telefone" 
                    Type="tel" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="Endereço" 
                    @bind-Value="professor.Endereco" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>

            <MudItem xs="12" md="3" Class="mb-3">
                <MudTextField 
                    Label="E-mail" 
                    @bind-Value="professor.Email" 
                    Type="email" 
                    Variant="Variant.Outlined" 
                    Required />
            </MudItem>
        </MudGrid>

        <!-- Botão de cadastro -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="4" Class="mt-4">
                <MudButton Color="Color.Success" Variant="Variant.Filled" Style="width: 100%; height: 50px;"
                           @onclick="@(() => { CadastrarProfessor(); Snackbar.Add("Cadastro efetuado com sucesso!", Severity.Success); })">
                    Cadastrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    private Professor professor = new();

    protected override async Task OnInitializedAsync()
    {
        var professorJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "professorEdicao");
        if (!string.IsNullOrEmpty(professorJson))
        {
            professor = System.Text.Json.JsonSerializer.Deserialize<Professor>(professorJson);
        }
    }

    private async Task CadastrarProfessor()
    {
        if (professor.ProfessorId > 0)
            ProfessorService.EditarProfessor(professor);
        else
            ProfessorService.AdicionarProfessor(professor);

        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "professorEdicao");
        Navigation.NavigateTo("/lista-professores");
    }
}
