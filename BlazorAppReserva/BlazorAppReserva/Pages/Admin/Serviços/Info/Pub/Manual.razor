@page "/Manual"
@inject ISnackbar Snackbar

<MudContainer>
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h4">🆘 Suporte e Ajuda</MudText>
            <MudText Typo="Typo.subtitle1">
                Encontre respostas rápidas para suas dúvidas ou entre em contato com nosso suporte técnico.
            </MudText>
        </MudCardHeader>

        <!-- Seção de FAQ -->
        <MudCardContent>
            <MudText Typo="Typo.h5">📖 FAQ - Perguntas Frequentes</MudText>
            <MudExpansionPanels>
                <MudExpansionPanel Text="Como faço uma reserva?">
                    <MudText>Para fazer uma reserva, acesse a página de reservas, selecione a data desejada, escolha seu quarto e siga as instruções de pagamento.</MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Posso cancelar minha reserva?">
                    <MudText>Sim, as reservas podem ser canceladas até 24 horas antes do check-in. Basta acessar seu perfil e selecionar a opção de cancelamento.</MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Como redefinir minha senha?">
                    <MudText>Clique em "Esqueci minha senha" na tela de login e siga as instruções enviadas para seu e-mail.</MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudCardContent>
    </MudCard>

    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">📩 Contato com Suporte Técnico</MudText>
            <MudForm>
                <MudGrid>
                    <MudGridItem xs="12" sm="6">
                        <MudTextField T="string" Label="Nome" Variant="Variant.Outlined" Required="true" />
                    </MudGridItem>
                    <MudGridItem xs="12" sm="6">
                        <MudTextField T="string" Label="E-mail" Variant="Variant.Outlined" Required="true" Type="email" />
                    </MudGridItem>
                    <MudGridItem xs="12">
                        <MudTextField T="string" Label="Mensagem" Variant="Variant.Outlined" Required="true" Multiline="true" Rows="4" />
                    </MudGridItem>
                </MudGrid>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@EnviarSuporte">
                    <MudIcon Icon="send" /> Enviar Solicitação
                </MudButton>
            </MudForm>
        </MudCardContent>
    </MudCard>

    <!-- Seção Publicitária -->
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h5">🌟 Promoções Exclusivas para Você!</MudText>
            <MudCarousel TData="string">
                <MudCarouselItem>
                    <MudImage Src="/images/promo1.jpg" Alt="Promoção 1" Width="100%" />
                </MudCarouselItem>
                <MudCarouselItem>
                    <MudImage Src="/images/promo2.jpg" Alt="Promoção 2" Width="100%" />
                </MudCarouselItem>
                <MudCarouselItem>
                    <MudImage Src="/images/promo3.jpg" Alt="Promoção 3" Width="100%" />
                </MudCarouselItem>
            </MudCarousel>
            <MudText Typo="Typo.subtitle1">Aproveite ofertas exclusivas nos melhores hotéis. Reserve agora e economize!</MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>

<!-- Exibição da mensagem de sucesso -->
<MudAlert Severity="Severity.Success" Elevation="2" Class="mt-3" Hidden="!exibirMensagem">
    🎉 Sua solicitação foi enviada com sucesso! Entraremos em contato em breve.
</MudAlert>

@code {
    private bool exibirMensagem = false;

    private void EnviarSuporte()
    {
        exibirMensagem = true;
    }
}








