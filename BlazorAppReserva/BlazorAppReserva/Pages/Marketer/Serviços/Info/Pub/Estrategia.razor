@page "/estrategia-planejamento"

<MudContainer>
    <MudCard Class="pa-4">
        <MudCardContent>
            <MudTypography Variant="h4" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Class="mr-2" />
                Estratégia e Planejamento
            </MudTypography>
            <MudTypography Variant="body1" Class="mb-4">
                Planejar e definir estratégias eficazes é essencial para o crescimento sustentável da marca.
            </MudTypography>
            
            <MudExpansionPanels>
                <MudExpansionPanel>
                    <MudExpansionPanelHeader>
                        <MudIcon Icon="@Icons.Material.Filled.Group" Class="mr-2" />
                        Definição do Público-Alvo
                    </MudExpansionPanelHeader>
                    <MudExpansionPanelContent>
                        <MudList T="string">
                            <MudListItem T="string">Identificação do perfil do consumidor ideal</MudListItem>
                            <MudListItem T="string">Análise de mercado e concorrência</MudListItem>
                            <MudListItem T="string">Segmentação demográfica, psicográfica e comportamental</MudListItem>
                        </MudList>
                    </MudExpansionPanelContent>
                </MudExpansionPanel>

                <MudExpansionPanel>
                    <MudExpansionPanelHeader>
                        <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                        Posicionamento da Marca
                    </MudExpansionPanelHeader>
                    <MudExpansionPanelContent>
                        <MudList T="string">
                            <MudListItem T="string">Definição da proposta de valor</MudListItem>
                            <MudListItem T="string">Comunicação da identidade da marca</MudListItem>
                            <MudListItem T="string">Diferenciação em relação à concorrência</MudListItem>
                        </MudList>
                    </MudExpansionPanelContent>
                </MudExpansionPanel>

                <MudExpansionPanel>
                    <MudExpansionPanelHeader>
                        <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-2" />
                        Planejamento de Campanhas
                    </MudExpansionPanelHeader>
                    <MudExpansionPanelContent>
                        <MudList T="string">
                            <MudListItem T="string">Estabelecimento de objectivos e metas</MudListItem>
                            <MudListItem T="string">Seleção dos canais de comunicação</MudListItem>
                            <MudListItem T="string">Cronograma e execução das acções</MudListItem>
                        </MudList>
                    </MudExpansionPanelContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudCardContent>
    </MudCard>
</MudContainer>
