@page "/Prop/Avaliacoes_Feedback"

@code {
    public IEnumerable<object>? avaliacoes { get; set; }
}


<MudContainer>
    <!-- Banner Promocional -->
    <MudPaper Class="promo-banner" Elevation="4">
        <MudText Typo="Typo.h4" Class="promo-title">💎 Eleve sua Hospitalidade! 💎</MudText>
        <MudText Typo="Typo.body1">Acompanhe as avaliações e transforme feedbacks em oportunidades! 🚀</MudText>
    </MudPaper>

    <MudTabs>
        <!-- Responder Avaliações -->
        <MudTabPanel Text="Responder Avaliações" Icon="@Icons.Material.Filled.Feedback">
            <MudTable Items="@avaliacoes" Class="animated fadeIn">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Nota</MudTh>
                    <MudTh>Comentário</MudTh>
                    <MudTh>Ação</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Nome</MudTd>
                    <MudTd>@context.Data</MudTd>
                    <MudTd><MudRating Value="@context.Nota" ReadOnly="true" /></MudTd>
                    <MudTd>@context.Comentario</MudTd>
                    <MudTd>
                        <MudButton OnClick="() => AbrirDialogoResposta(context)" Color="Primary" StartIcon="@Icons.Material.Filled.Reply">
                            Responder
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- Visualizar Feedbacks -->
        <MudTabPanel Text="Visualizar Feedbacks" Icon="@Icons.Material.Filled.Visibility">
            <MudExpansionPanels>
                @foreach (var feedback in feedbacks)
                {
                    <MudExpansionPanel Text="@feedback.Titulo">
                        <MudText>@feedback.Comentario</MudText>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudTabPanel>

        <!-- Analisar Classificação -->
        <MudTabPanel Text="Classificação do Hotel" Icon="@Icons.Material.Filled.Star">
            <MudPaper Elevation="3" Class="rating-card animated pulse">
                <MudText Typo="Typo.h5">Classificação Geral</MudText>
                <MudProgressCircular Value="@mediaNotas * 20" Color="Success" />
                <MudChart ChartType="Pie" Labels="labels" Data="dadosGrafico" />
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

<style>
    .promo-banner {
        text-align: center;
        padding: 20px;
        background: linear-gradient(135deg, #7b4397, #dc2430);
        color: white;
        border-radius: 10px;
        animation: fadeIn 1.5s;
    }

    .promo-title {
        font-weight: bold;
        font-size: 24px;
    }

    .rating-card {
        text-align: center;
        padding: 20px;
        background: #f5f5f5;
        border-radius: 10px;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.05); }
        100% { transform: scale(1); }
    }
</style>
