@page "/Prop/Reservas"

@using BlazorAppReserva.Pages.Admin.Reservas
@using MudBlazor

<MudContainer>
    <!-- Cabeçalho -->
    <MudPaper Elevation="4" Class="pa-4 d-flex justify-space-between align-center">
        <MudTypography Variant="H4" Class="fade-in">📅 Gerenciamento de Reservas</MudTypography>
        <MudButton 
            Variant="Variant.Outlined"
            Color="Color.Primary" 
            StartIcon="@Icons.Material.Filled.Refresh" 
            OnClick="AtualizarReservas">
            Actualizar
        </MudButton>
    </MudPaper>
    
    <!-- Filtros de Pesquisa -->
    <MudGrid Class="mt-4 slide-in">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField
                Variant="Variant.Outlined"
                Label="Buscar Hóspede" 
                @bind-Value="searchTerm" 
                Adornment="Adornment.Start" 
                AdornmentIcon="@Icons.Material.Filled.Search"
                Required/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker 
                Variant="Variant.Outlined"
                Label="Data de Entrada"
                @bind-Date="checkInDate" 
                Required/>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Variant="Variant.Outlined" Label="Data de Saída" @bind-Date="checkOutDate" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect Variant="Variant.Outlined" Label="Status" @bind-Value="selectedStatus">
                <MudSelectItem Value="Ativa">Ativa</MudSelectItem>
                <MudSelectItem Value="Cancelada">Cancelada</MudSelectItem>
                <MudSelectItem Value="Concluída">Concluída</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
    
    <!-- Tabela de Reservas -->
    <MudTable Items="reservas" Hover="true" Dense="true" Class="mt-4 fade-in">
        <HeaderContent>
            <MudTh>Hóspede</MudTh>
            <MudTh>Quarto</MudTh>
            <MudTh>Entrada</MudTh>
            <MudTh>Saída</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Acções</MudTh>
        </HeaderContent>
        <RowTemplate Context="reserva">
            <MudTd>@reserva.Hospede</MudTd>
            <MudTd>@reserva.Quarto</MudTd>
            <MudTd>@reserva.DataEntrada.ToShortDateString()</MudTd>
            <MudTd>@reserva.DataSaida.ToShortDateString()</MudTd>
            <MudTd>
                <MudChip
                    T="string"
                    Color="@(reserva.Status == "Ativa" ? Color.Success : reserva.Status == "Cancelada" ? Color.Error : Color.Info)">
                    @reserva.Status
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton 
                    Icon="@Icons.Material.Filled.Visibility" 
                    Color="Color.Primary" OnClick="() => VerDetalhes(reserva)" />
                <MudIconButton
                    Icon="@Icons.Material.Filled.Edit" 
                    Color="Color.Secondary" OnClick="() => EditarReserva(reserva)" />
                <MudIconButton 
                    Icon="@Icons.Material.Filled.Delete" 
                    Color="Color.Error" OnClick="() => CancelarReserva(reserva)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
    
    <!-- Conteúdo Publicitário -->
    <MudPaper Elevation="4" Class="pa-4 mt-6 text-center bounce-in">
        <MudTypography Variant="H5">🏨 Promoção Especial!</MudTypography>
        <MudTypography>Reserve um quarto de luxo e ganhe um jantar gratuito! 🍽️</MudTypography>
        <MudButton 
            Href=""
            Variant="Variant.Outlined" 
            Color="Color.Success" 
            StartIcon="@Icons.Material.Filled.LocalOffer">
            Saiba Mais
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string searchTerm;
    private DateTime? checkInDate;
    private DateTime? checkOutDate;
    private string selectedStatus;
    
    private List<GerenciarReservasAdmin.Reserva> reservas = new();
    public object Ativa { get; set; }
    public object Cancelada { get; set; }
    public object Concluída { get; set; }

    private void AtualizarReservas() { /* Atualiza os dados da tabela */ }
    private void VerDetalhes(GerenciarReservasAdmin.Reserva reserva) { /* Exibe detalhes da reserva */ }
    private void EditarReserva(GerenciarReservasAdmin.Reserva reserva) { /* Permite editar */ }
    private void CancelarReserva(GerenciarReservasAdmin.Reserva reserva) { /* Confirma e remove */ }
    
    public class Reserva
    {
        public string Hospede { get; set; }
        public string Quarto { get; set; }
        public DateTime DataEntrada { get; set; }
        public DateTime DataSaida { get; set; }
        public string Status { get; set; }
    }
}




