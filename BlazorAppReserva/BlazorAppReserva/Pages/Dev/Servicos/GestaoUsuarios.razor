@page "/GestaoUsuarios"

<PageTitle>Segurança no Sistema de Gestão Acadêmica</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <!-- Header de Introdução -->
    <MudText Typo="Typo.h3" Align="Align.Center" Color="Color.Primary" Class="my-4">
        Gestão de Usuários
    </MudText>

    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Inherit" Class="my-4">
        Gerencie todas as reservas e operações do seu hotel de forma eficiente.
        Acompanhe a disponibilidade de quartos, check-ins e check-outs, pagamentos,
        preferências dos hóspedes e muito mais em tempo real.
    </MudText>
</MudContainer>

<MudSpacer />

<!-- Tabs para controlar os usuários -->

<!-- Administrativa -->
<MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="my-4">
    Administrativa
</MudText>
<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="my-4">
    <MudTabPanel
        Text="Administrador"
        Icon="@Icons.Material.Filled.AdminPanelSettings"
        IconColor="Color.Primary"
        Color="@Color.Primary">
        <MudButton
            Href="/Admin/MenuAdmin"
            Variant="Variant.Filled"
            Color="Color.Primary"
            Size="Size.Small"
            FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudSpacer />

    <MudTabPanel
        Text="Proprietário do Hotel"
        Icon="@Icons.Material.Filled.Business"
        IconColor="Color.Secondary"
        Color="@Color.Primary">
        <MudButton
            Href="/Prop/Menu"
            Variant="Variant.Filled"
            Color="Color.Primary"
            Size="Size.Small"
            FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudSpacer />

    <MudTabPanel
        Text="Gerente"
        Icon="@Icons.Material.Filled.Assignment"
        IconColor="Color.Warning"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>
</MudTabs>

<MudSpacer />

<!-- Operacional -->
<MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="my-4">
    Operacional
</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="my-4">
    <MudTabPanel
        Text="Recepcionista "
        Icon="@Icons.Material.Filled.RoomService"
        IconColor="Color.Info"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudTabPanel
        Text="Agente Externo (Provedor Externo)"
        Icon="@Icons.Material.Filled.ConnectWithoutContact"
        IconColor="Color.Primary"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudTabPanel
        Text="Gestor de Tarifas "
        Icon="@Icons.Material.Filled.PriceChange"
        IconColor="Color.Secondary"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>
</MudTabs>

<!-- Público Geral -->
<MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Class="my-4">
    Público Geral
</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Class="my-4">
    <MudTabPanel
        Text="Marketer(Equipa de Marketing)"
        Icon="@Icons.Material.Filled.Campaign"
        IconColor="Color.Warning"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudTabPanel
        Text="Hóspedes"
        Icon="@Icons.Material.Filled.Bed"
        IconColor="Color.Success"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>

    <MudTabPanel
        Text="Visitantes"
        Icon="@Icons.Material.Filled.TravelExplore"
        IconColor="Color.Info"
        Color="@Color.Primary">
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth>
            Ver Mais Detalhes
        </MudButton>
    </MudTabPanel>
</MudTabs>

<MudContainer MaxWidth="MaxWidth.Large" Class="security-section my-4">
    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Inherit">
        Todos os dados trocados entre os usuários e o sistema são criptografados, utilizando tecnologia de criptografia de ponta, garantindo que informações sensíveis nunca sejam expostas.
    </MudText>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="security-section saiba-mais-container my-4">
    <!-- Outros conteúdos do Container -->
    <MudButton Href="/Admin/Sobre" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" FullWidth>
        Saiba Mais
    </MudButton>
</MudContainer>