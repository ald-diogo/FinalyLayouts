@page "/cadastro-hotel"
@using BlazorAppReserva.Models
@using BlazorAppReserva.Pages.Services
@inject HotelService HotelService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudPaper Class="p-4" Elevation="4">
    <MudForm>
        <!-- Cabeçalho da página -->
        <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">
            Cadastro de Hotéis
        </MudText>

        <!-- Primeira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Nome do Hotel"
                    @bind-Value="hotel.Nome"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Hotel"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Cidade"
                    @bind-Value="hotel.Cidade"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.LocationCity"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="País"
                    @bind-Value="hotel.Pais"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Public"
                    AdornmentColor="Color.Primary" />
            </MudItem>
        </MudGrid>

        <!-- Segunda linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Telefone"
                    @bind-Value="hotel.Telefone"
                    Type="tel"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Phone"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="E-mail"
                    @bind-Value="hotel.Email"
                    Type="email"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Email"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Endereço"
                    @bind-Value="hotel.Endereco"
                    Variant="Variant.Outlined"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Home"
                    AdornmentColor="Color.Primary" />
            </MudItem>
        </MudGrid>

        <!-- Terceira linha de campos do formulário -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Categoria (1-5)"
                    @bind-Value="hotel.Categoria"
                    Variant="Variant.Outlined"
                    Type="number"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.Star"
                    AdornmentColor="Color.Primary" />
            </MudItem>

            <MudItem xs="12" md="4" Class="mb-3">
                <MudTextField
                    Label="Preço por Noite"
                    @bind-Value="hotel.PrecoPorNoite"
                    Variant="Variant.Outlined"
                    Type="number"
                    Required
                    Adornment="Adornment.End"
                    AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                    AdornmentColor="Color.Primary" />
            </MudItem>
        </MudGrid>

        <!-- Serviços oferecidos -->
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudCheckBox T="string" @bind-Checked="hotel.Wifi" Label="Wi-Fi" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCheckBox T="string" @bind-Checked="hotel.Estacionamento" Label="Estacionamento" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCheckBox T="string" @bind-Checked="hotel.Piscina" Label="Piscina" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCheckBox T="string" @bind-Checked="hotel.Restaurante" Label="Restaurante" />
            </MudItem>
        </MudGrid>

        <!-- Botão de cadastro -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="4" Class="mt-4">
                <MudButton Color="Color.Success" Variant="Variant.Filled" Style="width: 100%; height: 100%;"
                           @onclick="@(() => { CadastrarHotel(); Snackbar.Add("Cadastro efetuado com sucesso!", Severity.Success); })">
                    Cadastrar
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    private Hotel hotel = new();

    protected override async Task OnInitializedAsync()
    {
        var hotelJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "hotelEdicao");
        
        if (!string.IsNullOrEmpty(hotelJson))
        {
            hotel = System.Text.Json.JsonSerializer.Deserialize<Hotel>(hotelJson);
        }
    }

    private async Task CadastrarHotel()
    {
        if (hotel.Id > 0)
            HotelService.EditarHotel(hotel);
        else
            HotelService.AdicionarHotel(hotel);
        
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "hotelEdicao");
        Navigation.NavigateTo("/lista-hoteis");
    }
}
