@using MudBlazor.Utilities
@inherits LayoutComponentBase
@inject IJSRuntime JS

<!-- Provedores de serviços do MudBlazor -->
<MudThemeProvider Theme="@CurrentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<!-- Layout principal -->
<MudLayout>
    @if (!HideAppBar)
    {
        <!-- Barra de navegação superior -->
        <MudAppBar Elevation="1" Color="@(_isDarkMode ? Color.Dark : Color.Default)">
            <MudIconButton
                Icon="@Icons.Material.Filled.Menu"
                Color="Color.Success"
                Edge="Edge.Start"
                OnClick="@DrawerToggle"/>
            <MudSpacer/>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudIcon Icon="@Icons.Custom.Brands.MicrosoftVisualStudio" Size="Size.Large"/>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.Xs">
                <a href="/">
                    <MudText Typo="Typo.h6" Class="ml-4" Color="Color.Success">Reserve Já!</MudText>
                </a>
            </MudHidden>

            <MudSpacer/>

            <MudMenu
                Icon="@Icons.Material.Outlined.Translate"
                IconColor="@Color.Success"
                Color="Color.Inherit"
                AnchorOrigin="Origin.TopCenter"
                TransformOrigin="Origin.TopCenter"
                Dense="true">
                <MudMenuItem>Português</MudMenuItem>
                <MudMenuItem>Inglês</MudMenuItem>
            </MudMenu>

            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopRight" Dense="true">
                <MudMenuActivator>
                    <div style="display: flex; align-items: center; cursor: pointer;">
                        <MudAvatar Style="margin-right: 8px;">
                            <MudImage Src="favicon.png" Alt="User"/>
                        </MudAvatar>
                    </div>
                </MudMenuActivator>
                <MudMenuItems>
                    <MudMenuItem Href="#" Icon="@Icons.Material.Filled.Password">Alterar Senha</MudMenuItem>
                    <MudMenuItem Href="#" Icon="@Icons.Material.Filled.ManageAccounts">Conta</MudMenuItem>
                    <MudDivider/>
                    <MudMenuItem Href="/logout" Icon="@Icons.Material.Filled.Logout" Color="Color.Error">Terminar Sessão</MudMenuItem>
                </MudMenuItems>
            </MudMenu>

            <MudMenu Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)">
                <MudMenuItem OnClick="@(() => SetTheme(false))" Icon="Icons.Material.Filled.LightMode">
                    Modo Claro ☀️
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => SetTheme(true))" Icon="Icons.Material.Filled.DarkMode">
                    Modo Escuro 🌙
                </MudMenuItem>
                <MudMenuItem Divider="true"/>
                <MudMenuItem OnClick="@ToggleTheme" Icon="Icons.Material.Filled.WbTwilight">
                    Automático 🌗
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>
    }

    <!-- Menu lateral -->
    <MudDrawer 
        @bind-Open="_drawerOpen" 
        Breakpoint="Breakpoint.Md" 
        Color="@(_isDarkMode ? Color.Dark : Color.Default)">
        <NavMenu/>
    </MudDrawer>

    <!-- Conteúdo principal -->
    <MudMainContent Class="@(_isDarkMode ? "dark-mode-background" : "")">
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [Parameter] public bool HideAppBar { get; set; } = false;
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private MudTheme CurrentTheme => _isDarkMode ? _darkTheme : _lightTheme;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private MudTheme _lightTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Blue.Accent3,
            Background = "#ffffff",
            AppbarText = Colors.Shades.Black,
            AppbarBackground = Colors.LightBlue.Darken4,
            DrawerBackground = Colors.LightBlue.Darken4
        }
    };

    private MudTheme _darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Blue.Accent3,
            Background = "#121212", // CORREÇÃO: Fundo realmente escuro
            AppbarText = "#ffffff",
            AppbarBackground = "#333333", // Deixando um tom mais escuro
            Surface = "#1e1e1e", // Melhorando a coerência visual
            TextPrimary = "#ffffff"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "themePreference");
        _isDarkMode = savedTheme == "dark";
        StateHasChanged();
    }

    private async Task SetTheme(bool isDark)
    {
        _isDarkMode = isDark;
        await JS.InvokeVoidAsync("localStorage.setItem", "themePreference", _isDarkMode ? "dark" : "light");
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "themePreference", _isDarkMode ? "dark" : "light");
        StateHasChanged();
    }
}









