@using MudBlazor.Utilities
@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider Theme="(_isDarkMode ? _darkTheme : _lightTheme)" />
<MudLayout>
    @if (!HideAppBar)
    {
    <MudAppBar Elevation="1" Color="Color.Dark">
        <!-- Switch para alternar temas -->
        <MudIconButton OnClick="@ToggleTheme"
                       Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                       Color="@(_isDarkMode ? Color.Primary : Color.Secondary)"
                       Class="ma-4"
                       title="@(_isDarkMode ? "Modo Escuro" : "Modo Claro")"/>
        <MudSpacer/>
    </MudAppBar>
    }
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Color="Color.Dark" Breakpoint="Breakpoint.Md">
        <MudDrawerHeader>
            <MudText Typo="Typo.h5" Class="mt-1" Color="Color.Primary">Menu</MudText>
        </MudDrawerHeader>
        <NavMenu/>
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

<MudDialogProvider />
<MudSnackbarProvider />

@code {
    [Parameter] public bool HideAppBar { get; set; } = false;
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private MudTheme _lightTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1EFA2D",
            Background = Colors.Blue.Lighten4,
            Secondary = Colors.LightBlue.Darken3,
            TextPrimary = Colors.Shades.Black,
            AppbarText = Colors.Shades.Black,
            AppbarBackground = new MudColor("#1EFA2D"),
            DrawerText = Colors.Shades.Black,
            DrawerBackground = Colors.LightBlue.Lighten4
        }
    };

    private MudTheme _darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.LightBlue.Accent3,
            Secondary = Colors.LightBlue.Darken3,
            AppbarBackground = Colors.LightBlue.Accent3,
            AppbarText = Colors.Shades.Black
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _isDarkMode = await JS.InvokeAsync<bool>("getSystemTheme");
        await JS.InvokeVoidAsync("watchSystemTheme", DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void SetDarkMode(bool isDark)
    {
        _isDarkMode = isDark;
        StateHasChanged();
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        StateHasChanged();
    }

}